# Copia este archivo como .env y ajusta los valores.

# URL del API Gateway (Kong). Sin barra final.
# En un celular con Expo Go NO uses localhost: usa la IP de tu computador en la red local,
# por ejemplo http://192.168.1.20:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# true  → autenticación y datos simulados (no necesita backend).
# false → peticiones reales a EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_USE_MOCK=true
