{
  "name": "vitalis-ribas",
  "version": "0.1.0",
  "private": true,
  "description": "Vitalis · RIBAS — frontend web (React + Vite), app móvil (Expo) y código compartido.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "frontend-web",
    "frontend-mobile"
  ],
  "scripts": {
    "web": "npm run dev -w frontend-web",
    "mobile": "npm run start -w frontend-mobile",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces && prettier --write .",
    "format:check": "npm run format:check --workspaces && prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "build:web": "npm run build -w frontend-web",
    "test:html": "node --test \"legacy-html/tests/*.test.mjs\""
  },
  "devDependencies": {
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  },
  "knip": {
    "ignore": [
      "legacy-html/**"
    ],
    "workspaces": {
      "frontend-web": {
        "entry": [
          "src/__tests__/*.{ts,tsx}"
        ]
      },
      "frontend-mobile": {
        "entry": [
          "src/app/**/*.tsx",
          "src/__tests__/*.{ts,tsx}"
        ],
        "metro": false,
        "ignoreDependencies": [
          "expo-updates",
          "expo-system-ui"
        ],
        "ignore": [
          "metro.config.js"
        ]
      },
      "packages/shared": {
        "entry": [
          "src/__tests__/*.ts"
        ]
      },
      "packages/shared-react": {
        "entry": [
          "src/__tests__/*.{ts,tsx}"
        ]
      }
    }
  }
}
